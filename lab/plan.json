{
  "schema": "retsar.lab-plan.v1",
  "status": "deployment-template",
  "executable": false,
  "launcherImplemented": true,
  "supervisor": "supervise_qemu.py",
  "validation": {
    "fakeApiTestsPassed": 16,
    "nativeOwnedChildChecksPassed": 2,
    "nativeCheckScope": "Newly created sleeping Python helpers: job termination and kill on job closure.",
    "qemuStartupAttempted": true,
    "guestBootObserved": false,
    "guestSessionCreationProven": false
  },
  "purpose": "Validate the C++ RDS provider against a real Windows Server guest.",
  "doesNotProve": [
    "physical multiseat on Windows 11 Home",
    "independent ownership of host monitors or input devices",
    "hardware graphics acceleration or application compatibility"
  ],
  "approval": {
    "requiredForEachDeployment": true,
    "granted": false,
    "requiredFor": [
      "resource consumption and guest provisioning",
      "official evaluation media and its applicable license terms"
    ]
  },
  "guest": {
    "product": "Windows Server 2022 Standard Evaluation",
    "installationOption": "Desktop Experience",
    "architecture": "x86_64",
    "requiredRole": "RD Session Host",
    "mediaObtained": false,
    "licenseAccepted": false,
    "installed": false,
    "rdshConfigured": false,
    "providerReady": false,
    "configurationMarker": "rdsh-configured",
    "configurationMarkerChecks": ["RDS-RD-Server installed", "TermService running"],
    "configurationMarkerDoesNotProve": ["provider registration", "session creation", "isolation"],
    "evaluationDays": 180,
    "activationRequiredWithinDays": 10,
    "rdsInitialLicensingGraceDays": 120,
    "activationAndUpdateNetworkPlan": "pending; baseline has no guest outbound access"
  },
  "resources": {
    "memoryMiB": 4096,
    "virtualCpuCount": 2,
    "accelerator": "tcg",
    "hardwareAccelerationAssumed": false,
    "hostProcessPriority": "BelowNormal",
    "disk": {
      "format": "qcow2",
      "virtualCapacityGiB": 64,
      "allocation": "sparse",
      "preallocation": "off",
      "hostVolume": "C",
      "hostFreeSpaceFloorGiB": 25,
      "guestWriteThrottleMiBPerSecond": 16,
      "growthGuard": {
        "required": true,
        "implemented": true,
        "componentChecksPassed": true,
        "vmGrowthUnderLoadVerified": false,
        "stopWhenFreeGiBAtOrBelow": 26,
        "pollIntervalMs": 200,
        "heartbeatTimeoutMs": 2000,
        "absoluteFreeSpaceGuarantee": false,
        "behavior": [
          "Check all C: volume free space before launch and while supervising the guest.",
          "Terminate only the supervisor's owned job on threshold, monitor failure or controller EOF.",
          "Keep the unnamed kill-on-close job handle non-inheritable.",
          "Create the child suspended, assign its handle to the job, then resume it."
        ],
        "limitations": [
          "Provisioning, media downloads and disk copies require separate preflight checks.",
          "Other applications, delayed polling and buffered writes can cross the desired floor.",
          "The guest-disk throttle does not cap every host write.",
          "Forced termination can leave the disposable guest disk unclean."
        ]
      }
    }
  },
  "machineProposal": {
    "chipset": "q35",
    "cpuModel": "max",
    "firmware": "UEFI; compatible firmware files must be verified before provisioning",
    "storageInterface": "emulated NVMe; guest boot compatibility not yet tested",
    "graphics": "emulated standard VGA; no host GPU passthrough",
    "pointer": "emulated USB tablet; no host device passthrough",
    "guestMemoryDumpExclusionEnforced": false,
    "unsupportedWindowsOptionRemoved": "dump-guest-core=off",
    "compatibilityValidated": false
  },
  "access": {
    "localDisplayWindow": false,
    "vnc": { "bindAddress": "127.0.0.1", "tcpPort": 5905 },
    "rdp": { "bindAddress": "127.0.0.1", "hostTcpPort": 13389, "guestTcpPort": 3389 },
    "networkBackend": "user-mode",
    "restrictGuestNetworking": true,
    "outboundInternet": false,
    "checkPortsBeforeLaunch": true,
    "stopIfPortOccupied": true
  },
  "controller": {
    "transport": "QMP over private child stdin and stdout pipes",
    "guestInitiallyPaused": true,
    "stdinEofTerminatesGuest": true,
    "arbitraryQmpCommandsAllowed": false,
    "guestSerialLogStopMiB": 16,
    "guestSerialThresholdMayOvershootBetweenChecks": true,
    "stderrLogCapMiB": 4
  },
  "unattendedSetup": {
    "template": "autounattend.xml.template",
    "bootstrap": "guest-bootstrap.ps1",
    "reviewed": true,
    "executedInGuest": false,
    "optionalAnswerIsoReadOnly": true,
    "generatedAnswerMediaContainsPlaintextCredentials": true,
    "generatedAnswerMediaMustRemainPrivate": true,
    "templateAcceptsEvaluationEula": true,
    "templateWipesGuestDiskZero": true,
    "wipeScopeDependsOnFixedDisposableQcow2Attachments": true,
    "bootstrapGatesProtectEarlierSetupWipe": false,
    "bootstrapRequiredEnvironment": ["hostname RETSARLAB", "manufacturer QEMU", "Windows Server"],
    "bootstrapRegistersProvider": false,
    "bootstrapCreatesSeat": false
  },
  "hostIntegration": {
    "installHostDrivers": false,
    "changeHostServices": false,
    "enableHypervisorFeatures": false,
    "createNetworkBridge": false,
    "createTapAdapter": false,
    "rebootHost": false,
    "attachPhysicalDisks": false,
    "passThroughHostDevices": false,
    "shareFolders": false,
    "shareClipboard": false,
    "redirectRdpDrives": false,
    "redirectRdpDevices": false,
    "storeGuestCredentialsInRepository": false
  },
  "paths": {
    "qemuExecutablePlaceholder": "<verified-qemu-directory>/qemu-system-x86_64.exe",
    "privateWorkRootPlaceholder": "<private-work-root>/lab",
    "relativeToPrivateWorkRoot": {
      "installationMedia": "media/windows-server-evaluation.iso",
      "optionalPrivateAnswerMedia": "media/private-answer.iso",
      "guestDisk": "disks/server-evaluation.qcow2",
      "firmwareVariables": "firmware/guest-vars.fd",
      "reports": "reports",
      "logs": "logs",
      "guestSerialLog": "logs/guest-serial.log"
    },
    "resolveOnlyToOrdinaryDirectoriesOnC": true,
    "concreteHostPathsKeptOutsideRepository": true
  },
  "perDeploymentPrerequisites": [
    "Obtain explicit resource and applicable license approval.",
    "Obtain and verify official media; prepare only a disposable guest disk.",
    "Verify QEMU dependencies, firmware, private paths and loopback ports.",
    "Review private answer-media credentials and the fixed guest-disk-only wipe scope.",
    "Keep the supervisor controller input open throughout the run.",
    "Agree activation and updates networking separately from the restricted baseline.",
    "Treat guest boot, role configuration and real session creation as separate unproven stages."
  ]
}
